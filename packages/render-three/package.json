{
  "name": "@aegis/render-three",
  "version": "0.0.0",
  "description": "three.js-backed render adapters for all three modes, plus a browser dev server. Depends on core; core never depends on rendering.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aegis/core": "*",
    "@aegis/content": "*",
    "@aegis/harness": "*",
    "@aegis/mode-platformer": "*",
    "@aegis/mode-iso": "*",
    "@aegis/mode-fps": "*",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0"
  }
}
