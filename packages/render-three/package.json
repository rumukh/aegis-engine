{
  "name": "@aegis/render-three",
  "version": "0.0.0",
  "description": "three.js-backed render adapters for all three modes, plus a browser dev server. Depends on core; core never depends on rendering.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./client/static-boot": {
      "types": "./dist/client/static-boot.d.ts",
      "import": "./dist/client/static-boot.js"
    },
    "./client/boot": {
      "types": "./dist/client/boot.d.ts",
      "import": "./dist/client/boot.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "import": "./dist/presentation/index.js"
    },
    "./presentation/schema": {
      "types": "./dist/presentation/schema.d.ts",
      "import": "./dist/presentation/schema.js"
    },
    "./presentation/validate": {
      "types": "./dist/presentation/validate.d.ts",
      "import": "./dist/presentation/validate.js"
    },
    "./presentation/node": {
      "types": "./dist/presentation/files.d.ts",
      "import": "./dist/presentation/files.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./preview/client": {
      "types": "./dist/preview/client/boot.d.ts",
      "import": "./dist/preview/client/boot.js"
    },
    "./preview/studio": {
      "types": "./dist/preview/studio.d.ts",
      "import": "./dist/preview/studio.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aegis/core": "*",
    "@aegis/content": "*",
    "@aegis/harness": "*",
    "@aegis/mode-platformer": "*",
    "@aegis/mode-iso": "*",
    "@aegis/mode-fps": "*",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0"
  }
}
