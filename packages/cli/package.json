{
  "name": "@aegis/cli",
  "version": "0.0.0",
  "description": "The single CLI surface: run, test, inspect, validate, record, replay, scaffold. No GUI is ever required.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aegis": "./bin/aegis.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aegis/core": "*",
    "@aegis/content": "*",
    "@aegis/harness": "*",
    "@aegis/mode-platformer": "*",
    "@aegis/mode-iso": "*",
    "@aegis/mode-fps": "*",
    "@aegis/render-three": "*"
  }
}
