node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.tmp/
.cache/
out/

# Editor and merge leftovers. Also guarded by test/stray-artifacts.test.ts, because
# .gitignore does not stop git add -f and does not notice an already-tracked file.
*.bak
*.orig
*.rej
*.swp
*~

# The self-description a test run writes about itself, consumed by scripts/audit-test-report.mjs
# in the same process that produced it. Never committed: a checked-in report is a claim about
# a run nobody can point at.
.vitest-report.json
