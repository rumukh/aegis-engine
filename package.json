{
  "name": "aegis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aegis — an agent-first, deterministic, headless-first game engine.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf \"packages/*/dist\" \"packages/*/*.tsbuildinfo\" \"*.tsbuildinfo\"",
    "build": "tsc -b",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && npm run test && npm run lint",
    "lint": "npm run lint:code && npm run lint:deps && npm run format:check",
    "lint:code": "eslint .",
    "lint:deps": "node scripts/check-deps.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
